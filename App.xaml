<Application
    x:Class="DomeOSAgentDev.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- Color only. Everything else is the stock WinUI look: the app builds its layout out
                     of NavigationView, Expander, TreeView, TextBox and AccentButtonStyle rather than
                     hand-written control templates.

                     The Accent* keys are overridden so the built-in styles pick up the classic blue
                     (#4A90E2) instead of whatever accent the machine happens to use. -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>

                        <ResourceDictionary x:Key="Light">
                            <Color x:Key="AppAccentColor">#FF4A90E2</Color>
                            <SolidColorBrush x:Key="AppAccentBrush" Color="#FF4A90E2" />
                            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#264A90E2" />
                            <SolidColorBrush x:Key="AppOkBrush" Color="#FF2E8B52" />
                            <SolidColorBrush x:Key="AppWarnBrush" Color="#FFC8402B" />

                            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4A90E2" />
                            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64A90E2" />
                            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC4A90E2" />
                            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#4D4A90E2" />
                            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF3D82D2" />
                            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#C43D82D2" />
                            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#A63D82D2" />
                            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#5C3D82D2" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#87FFFFFF" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFFFF" />
                        </ResourceDictionary>

                        <ResourceDictionary x:Key="Dark">
                            <Color x:Key="AppAccentColor">#FF4A90E2</Color>
                            <SolidColorBrush x:Key="AppAccentBrush" Color="#FF4A90E2" />
                            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#334A90E2" />
                            <SolidColorBrush x:Key="AppOkBrush" Color="#FF4CC777" />
                            <SolidColorBrush x:Key="AppWarnBrush" Color="#FFF0705C" />

                            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4A90E2" />
                            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64A90E2" />
                            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC4A90E2" />
                            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#4D4A90E2" />
                            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF6BA6E8" />
                            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#C46BA6E8" />
                            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#A66BA6E8" />
                            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#5C6BA6E8" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#87FFFFFF" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFFFF" />
                        </ResourceDictionary>

                        <ResourceDictionary x:Key="HighContrast">
                            <Color x:Key="AppAccentColor">#FF4A90E2</Color>
                            <SolidColorBrush x:Key="AppAccentBrush" Color="#FF4A90E2" />
                            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#334A90E2" />
                            <SolidColorBrush x:Key="AppOkBrush" Color="#FF4CC777" />
                            <SolidColorBrush x:Key="AppWarnBrush" Color="#FFFF8C7A" />

                            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4A90E2" />
                            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64A90E2" />
                            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC4A90E2" />
                            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#4D4A90E2" />
                            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF6BA6E8" />
                            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#C46BA6E8" />
                            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#A66BA6E8" />
                            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#5C6BA6E8" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#87FFFFFF" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFFFF" />
                        </ResourceDictionary>

                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>

                <!-- The only two custom styles in the app, and they exist for one reason: to make a
                     status colour follow the window theme. A brush read straight out of
                     Application.Current.Resources would ignore a forced light/dark window. -->
                <ResourceDictionary>
                    <Style x:Key="DomeTextOk" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource AppOkBrush}" />
                    </Style>
                    <Style x:Key="DomeTextWarn" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{ThemeResource AppWarnBrush}" />
                    </Style>
                    <Style x:Key="DomeGlyphOk" TargetType="FontIcon">
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
                        <Setter Property="Foreground" Value="{ThemeResource AppOkBrush}" />
                    </Style>
                    <Style x:Key="DomeGlyphWarn" TargetType="FontIcon">
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
                        <Setter Property="Foreground" Value="{ThemeResource AppWarnBrush}" />
                    </Style>

                    <!-- The easter-egg bubble: a card that opens its link when clicked. It is a Button
                         so it inherits the stock hover and press feedback. -->
                    <Style x:Key="DomeEggBubble" TargetType="Button">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="MaxWidth" Value="430" />
                        <Setter Property="Padding" Value="14,11,16,12" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>

                    <Style x:Key="DomeEggWho" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="CharacterSpacing" Value="60" />
                        <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
                    </Style>

                    <Style x:Key="DomeEggTitleCool" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="26" />
                        <Setter Property="FontWeight" Value="ExtraBold" />
                        <Setter Property="Foreground" Value="#FF3AA0FF" />
                    </Style>

                    <Style x:Key="DomeEggTitleWarm" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="26" />
                        <Setter Property="FontWeight" Value="ExtraBold" />
                        <Setter Property="Foreground" Value="#FFE84828" />
                    </Style>
                </ResourceDictionary>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
