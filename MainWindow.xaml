<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DomeOSAgentDev.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 背景层：纯色 / 图片模式下铺满整个窗口，亚克力模式下藏起来交给系统画 -->
        <Grid x:Name="BackdropLayer" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border x:Name="BackdropSolid" />
            <Image x:Name="BackdropImage" Stretch="UniformToFill" />
            <Border x:Name="BackdropDim" Background="Black" Opacity="0" />
        </Grid>

        <!-- 标题栏：应用图标 + 应用名，右侧给系统窗口按钮留位（Windows 11 原生应用的做法） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionSpacer" Width="138" />
            </Grid.ColumnDefinitions>

            <Image x:Name="LogoImage" Grid.Column="0" Width="18" Height="18"
                   Margin="18,0,0,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="DomeOS AI Agent Dev" Margin="11,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="264"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="对话" Tag="chat">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="工作区" Tag="workspace">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Button x:Name="ProviderButton" HorizontalAlignment="Stretch" Margin="4,4,4,10"
                        Padding="10,8" HorizontalContentAlignment="Left" Click="ProviderButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{ThemeResource AppAccentBrush}">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE945;"
                                      FontSize="13" Foreground="White" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProviderNameText" Text="未配置服务商"
                                       Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ModelNameText" Text="未选择模型"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>

            <Grid>

                <!-- ===================== 对话 ===================== -->
                <Grid x:Name="ChatPanel">
                    <Grid.Resources>
                        <DataTemplate x:Key="DomeUserMessage">
                            <!-- 主人这一侧固定蓝底黑字，深浅两套主题都是同一个色，一眼就能分出来 -->
                            <Border HorizontalAlignment="Right" MaxWidth="620" Padding="14,10" CornerRadius="8"
                                    Background="#FF4A90E2"
                                    BorderBrush="#FF3F7FC4" BorderThickness="1">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="#FF000000" />
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="DomeAssistantMessage">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </DataTemplate>
                    </Grid.Resources>

                    <!-- 图库：一次铺开全部对话，像「照片」那样一格一格排出来 -->
                    <Grid x:Name="GalleryPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="28,0,28,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center">
                                <Button Content="新对话" Style="{StaticResource AccentButtonStyle}"
                                        Click="NewConversation_Click" />
                                <ToggleButton x:Name="FavoriteOnlyToggle" Content="只看收藏"
                                              Click="FavoriteOnly_Click" />
                                <TextBlock x:Name="GalleryCountText" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="GalleryEmptyText" Grid.Column="1"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="点一张卡片打开对话" />
                        </Grid>

                        <GridView x:Name="ConversationGrid" Grid.Row="1" Margin="24,0,24,20"
                                  IsItemClickEnabled="True" SelectionMode="None"
                                  ItemClick="ConversationGrid_ItemClick">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="4" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="250" Height="170" Padding="14,12" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold"
                                                           Foreground="#FFC8952B" />
                                                <TextBlock Text="{Binding Count}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="0,6,0,4"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2" Text="{Binding Preview}" TextWrapping="Wrap"
                                                       MaxLines="3" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Grid.Row="3" Text="{Binding When}" Margin="0,6,0,0"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>

                    <!-- 单条对话 -->
                    <Grid x:Name="ThreadPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="28,0,28,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center">
                                <Button Click="BackToGallery_Click" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                  Glyph="&#xE72B;" FontSize="12" />
                                        <TextBlock Text="返回" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="ThreadTitleText" VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Spacing="8">
                                <ToggleButton x:Name="ThreadFavoriteToggle" Content="收藏"
                                              Click="ThreadFavorite_Click" />
                                <Button Content="删除对话" Click="DeleteConversation_Click" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer x:Name="TranscriptScroller" Grid.Row="1" Padding="28,4,28,8"
                                      HorizontalContentAlignment="Stretch"
                                      HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Disabled"
                                      SizeChanged="TranscriptScroller_SizeChanged"
                                      VerticalScrollBarVisibility="Auto">
                        <!-- 这一列的宽度由代码按视口算好，不然 ScrollViewer 会把它缩成最宽那条消息再居中，
                             气泡就全跑到中间去了。 -->
                        <StackPanel x:Name="TranscriptPanel" Spacing="14" HorizontalAlignment="Left" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Padding="28,0,28,20" Spacing="10" MaxWidth="780">
                        <!-- 窗口拉窄的时候这一行会放不下：让它横向滚动，别把「朗读」这样的按钮挤没 -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <DropDownButton x:Name="ModelChipButton" Padding="12,6">
                                    <DropDownButton.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="8" Height="8" Fill="{ThemeResource AppAccentBrush}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="ModelChipText" Text="未选择模型"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="ModelFlyout" Placement="TopEdgeAlignedLeft"
                                                    Opening="ModelFlyout_Opening" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <ToggleButton x:Name="DeepThinkChip" Content="深度思考" Click="DeepThinkChip_Click" />
                                <ToggleButton x:Name="WebSearchChip" Content="联网搜索" Click="WebSearchChip_Click" />
                                <Button x:Name="PermissionChip" Click="PermissionChip_Click" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon x:Name="PermissionIcon" Style="{StaticResource DomeGlyphWarn}"
                                                  Glyph="&#xE72E;" FontSize="12" />
                                        <TextBlock x:Name="PermissionText" Text="工作区 · 自动批准"
                                                   Style="{StaticResource DomeTextWarn}" />
                                    </StackPanel>
                                </Button>
                                <!-- 朗读按钮挪到每条回答旁边了，底栏不再放 -->
                            </StackPanel>
                        </ScrollViewer>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBox x:Name="ComposerBox" MinHeight="78" MaxHeight="200"
                                         Padding="12,10,46,10"
                                         PlaceholderText="所见即所想，所想即所求"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         PreviewKeyDown="ComposerBox_PreviewKeyDown"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,8,8" Width="34" Height="34" Padding="0"
                                        Background="Transparent" BorderThickness="0" Click="Attach_Click">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                              Glyph="&#xE723;" FontSize="14" />
                                </Button>
                            </Grid>

                            <Button Grid.Column="1" x:Name="SendButton" Style="{StaticResource AccentButtonStyle}"
                                    Margin="10,0,0,0" MinWidth="98" VerticalAlignment="Bottom"
                                    Click="SendButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE725;"
                                              FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    <TextBlock Text="发送" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="HintText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="回车发送 · Shift+回车 换行 · Ctrl+L 清屏" />
                    </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===================== 工作区 ===================== -->
                <Grid x:Name="WorkspacePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="28,0,28,8" Padding="16,14" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock x:Name="WorkspaceNameText" Text="未选择工作区"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="WorkspacePathText" Text="选择一个文件夹作为 Agent 的工作目录"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                                        HorizontalAlignment="Right"
                                        Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="PickWorkspaceButton" Content="选择文件夹" Click="PickWorkspace_Click" />
                                <Button Content="刷新" Click="RefreshWorkspace_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TreeView x:Name="WorkspaceTree" Grid.Row="1" Margin="28,4,28,8"
                              SelectionMode="Single"
                              Expanding="WorkspaceTree_Expanding"
                              ItemInvoked="WorkspaceTree_ItemInvoked">
                        <TreeView.ItemTemplate>
                            <!-- 行的 DataContext 是 TreeViewNode，不是节点的 Content，
                                 所以每一项都要从 Content. 进去取，直接绑 Name 会是空的 -->
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="{Binding Content.Glyph}" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock x:Name="WorkspaceHintText" Grid.Row="2" Margin="28,0,28,20"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="展开文件夹查看内容，点文件可看完整路径。" TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- ===================== 设置 ===================== -->
                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <ScrollViewer Padding="28,0,28,24" VerticalScrollBarVisibility="Auto">
                        <!-- a Grid, not a StackPanel: every section must end up exactly the same width,
                             and only a Grid gives its children one definite column width -->
                        <Grid MaxWidth="1000" HorizontalAlignment="Stretch" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Expander x:Name="AppearanceExpander" Grid.Row="0" Header="外观" IsExpanded="True"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Margin="0,4,0,8" Padding="16,14" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="应用主题" />
                                                <TextBlock Text="跟随系统，或固定浅色 / 深色。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="180"
                                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                                <ComboBoxItem Content="跟随系统" />
                                                <ComboBoxItem Content="浅色" />
                                                <ComboBoxItem Content="深色" />
                                            </ComboBox>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="语言" />
                                                <TextBlock Text="界面与回答的默认语言。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="320"
                                                      DisplayMemberPath="Name"
                                                      SelectionChanged="LanguageCombo_SelectionChanged" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="侧栏宽度" />
                                                <TextBlock Text="NavigationView 展开时的宽度（像素）。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <NumberBox x:Name="SidebarWidthBox" Grid.Column="1" Width="180"
                                                       SpinButtonPlacementMode="Compact" Minimum="190"
                                                       Maximum="560" SmallChange="8"
                                                       ValueChanged="SidebarWidthBox_ValueChanged" />
                                        </Grid>

                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="背景" />
                                                <TextBlock Text="云母和亚克力是系统的两种材料；纯色和图片由本软件自己铺一层。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="BackgroundModeCombo" Grid.Column="1" Width="180"
                                                      SelectionChanged="BackgroundModeCombo_SelectionChanged">
                                                <ComboBoxItem Content="云母" />
                                                <ComboBoxItem Content="亚克力" />
                                                <ComboBoxItem Content="纯色" />
                                                <ComboBoxItem Content="图片" />
                                            </ComboBox>
                                        </Grid>

                                        <Grid x:Name="BackgroundColorRow">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="底色" />
                                                <TextBlock Text="纯色模式下铺满整窗的颜色。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ColorPicker x:Name="BackgroundColorPicker" Grid.Column="1"
                                                         IsAlphaEnabled="False" IsAlphaSliderVisible="False"
                                                         IsAlphaTextInputVisible="False" IsColorChannelTextInputVisible="False"
                                                         IsMoreButtonVisible="False" IsHexInputVisible="True"
                                                         ColorSpectrumShape="Box"
                                                         ColorChanged="BackgroundColorPicker_ColorChanged" />
                                        </Grid>

                                        <StackPanel x:Name="BackgroundImageRow" Spacing="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="图片" />
                                                    <TextBlock x:Name="BackgroundFileText" Text="未设置"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <Button Content="选一张图片…" Click="PickBackground_Click" />
                                                    <Button Content="清除" Click="ClearBackground_Click" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="显示方式" VerticalAlignment="Center" />
                                                <ComboBox x:Name="BackgroundFitCombo" Grid.Column="1" Width="180"
                                                          SelectionChanged="BackgroundFitCombo_SelectionChanged">
                                                    <ComboBoxItem Content="铺满" />
                                                    <ComboBoxItem Content="适应" />
                                                </ComboBox>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="压暗" />
                                                    <TextBlock Text="图片模式下把背景压暗一点，字才看得清。"
                                                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Slider x:Name="BackgroundDimSlider" Grid.Column="1" Width="220"
                                                        Minimum="0" Maximum="0.9" StepFrequency="0.05"
                                                        ValueChanged="BackgroundDimSlider_ValueChanged" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="ProviderExpander" Grid.Row="1" Header="服务商"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Expanding="ProviderExpander_Expanding">
                                <Border Margin="0,4,0,8" Padding="16,14" CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="当前服务商" />
                                            <ComboBox x:Name="ProviderPicker" HorizontalAlignment="Stretch"
                                                      SelectionChanged="ProviderPicker_SelectionChanged" />
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="添加其他服务商" />
                                            <TextBlock Text="内置 39 家预设，挑一家加入后，接口地址、模型都可以按自己的端点改。"
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ComboBox x:Name="PresetPicker" MinWidth="300"
                                                          PlaceholderText="挑一个预设加入…" />
                                                <Button Content="添加" Click="AddProvider_Click" />
                                                <Button Content="＋ 添加自定义 API" Click="AddCustomProvider_Click" />
                                                <Button Content="设为当前" Click="SetActiveProvider_Click" />
                                                <Button Content="删除" Click="DeleteProvider_Click" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="名称" VerticalAlignment="Center" />
                                                <TextBox x:Name="ProviderNameBox" Grid.Column="1" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="协议" VerticalAlignment="Center" />
                                                <ComboBox x:Name="ProviderProtoBox" Grid.Column="1"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="ProviderProtoBox_SelectionChanged">
                                                    <ComboBoxItem Content="OpenAI 兼容" Tag="openai" />
                                                    <ComboBoxItem Content="Anthropic" Tag="anthropic" />
                                                    <ComboBoxItem Content="Gemini" Tag="gemini" />
                                                    <ComboBoxItem Content="Ollama" Tag="ollama" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="模型" VerticalAlignment="Center" />
                                                <!-- 「刷新」塞进同一列里：另起一列会把这一行的输入框整体往左挤，
                                                     和其它行的左边缘对不齐 -->
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ProviderModelBox" Grid.Column="0"
                                                              HorizontalAlignment="Stretch" IsEditable="True"
                                                              PlaceholderText="挑一个，或直接输入" />
                                                    <Button Grid.Column="1" Content="刷新" Margin="8,0,0,0"
                                                            Click="RefreshModels_Click" />
                                                </Grid>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="接口地址" VerticalAlignment="Center" />
                                                <TextBox x:Name="ProviderBaseBox" Grid.Column="1"
                                                         LostFocus="ProviderBaseBox_LostFocus" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="API Key" VerticalAlignment="Center" />
                                                <PasswordBox x:Name="ProviderKeyBox" Grid.Column="1"
                                                             PasswordRevealMode="Peek"
                                                             LostFocus="ProviderKeyBox_LostFocus" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="温度 / 最大回复" VerticalAlignment="Center" />
                                                <!-- 两个数放在同一个 320 里，左边缘才和上面几行对齐 -->
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <NumberBox x:Name="ProviderTempBox" Grid.Column="0"
                                                               Margin="0,0,8,0" SpinButtonPlacementMode="Compact"
                                                               Minimum="0" Maximum="2" SmallChange="0.1" Value="0.7" />
                                                    <NumberBox x:Name="ProviderMaxBox" Grid.Column="1"
                                                               SpinButtonPlacementMode="Compact" Minimum="0"
                                                               Maximum="200000" SmallChange="256" Value="0" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Text="0 表示最大回复不限；密钥只存在本机。"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                        <Button Content="保存这家服务商" Style="{StaticResource AccentButtonStyle}"
                                                HorizontalAlignment="Left" Click="SaveProvider_Click" />
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="PersonaExpander" Grid.Row="2" Header="角色"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Margin="0,4,0,8" Padding="16,14" CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="这段文字作为系统提示词，随每一轮对话发给当前服务商。"
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBox x:Name="PersonaBox" Height="300" AcceptsReturn="True"
                                                 TextWrapping="Wrap" HorizontalAlignment="Stretch" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="恢复默认人设" Click="ResetPersona_Click" />
                                            <Button Content="应用到当前服务商" Style="{StaticResource AccentButtonStyle}"
                                                    Click="ApplyPersona_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="VoiceExpander" Grid.Row="3" Header="语音"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Margin="0,4,0,8" Padding="16,14" CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="320" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="朗读引擎" />
                                                <TextBlock Text="自动会先试 MiMo，失败或没钥匙时改用系统讲述人的语音。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="VoiceEngineCombo" Grid.Column="1"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="VoiceEngineCombo_SelectionChanged">
                                                <ComboBoxItem Content="自动" Tag="auto" />
                                                <ComboBoxItem Content="MiMo 语音" Tag="mimo" />
                                                <ComboBoxItem Content="Microsoft 语音" Tag="microsoft" />
                                                <ComboBoxItem Content="虚拟歌姬" Tag="vocaloid" />
                                            </ComboBox>
                                        </Grid>

                                        <!-- 虚拟歌姬：只有引擎选了它才展开 -->
                                        <StackPanel x:Name="VocaloidPanel" Spacing="12" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="歌姬预设" />
                                                    <TextBlock Text="洛天依、初音未来是本机声库配音高的近似音色；装了真声库就在下面直接选。"
                                                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ComboBox x:Name="VocaloidPresetCombo" Grid.Column="1"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="VocaloidPresetCombo_SelectionChanged">
                                                    <ComboBoxItem Content="洛天依（近似）" Tag="luotianyi" />
                                                    <ComboBoxItem Content="初音未来（近似）" Tag="miku" />
                                                    <ComboBoxItem Content="自定义" Tag="custom" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="声库" VerticalAlignment="Center" />
                                                <ComboBox x:Name="VocaloidVoiceCombo" Grid.Column="1"
                                                          HorizontalAlignment="Stretch"
                                                          PlaceholderText="跟随系统默认声库"
                                                          SelectionChanged="VocaloidVoiceCombo_SelectionChanged" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="音高" />
                                                    <TextBlock x:Name="VocaloidPitchLabel" Text="+20%"
                                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                                </StackPanel>
                                                <Slider x:Name="VocaloidPitchSlider" Grid.Column="1" Width="220"
                                                        Minimum="-50" Maximum="60" StepFrequency="1"
                                                        ValueChanged="VocaloidPitchSlider_ValueChanged" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="歌姬语速" />
                                                    <TextBlock Text="-10 到 10，0 是正常语速。"
                                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                                </StackPanel>
                                                <NumberBox x:Name="VocaloidRateBox" Grid.Column="1" Width="180"
                                                           SpinButtonPlacementMode="Compact" Minimum="-10"
                                                           Maximum="10" SmallChange="1"
                                                           ValueChanged="VocaloidRateBox_ValueChanged" />
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="配音软件" />
                                                    <TextBlock Text="接上 X Studio 这类外部歌姬软件。它没有公开接口，朗读时会把文字复制好并启动它。"
                                                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ComboBox x:Name="VocaloidAppCombo" Grid.Column="1"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="VocaloidAppCombo_SelectionChanged">
                                                    <ComboBoxItem Content="内置（近似音色）" Tag="builtin" />
                                                    <ComboBoxItem Content="X Studio" Tag="xstudio" />
                                                    <ComboBoxItem Content="自定义程序…" Tag="custom" />
                                                </ComboBox>
                                            </Grid>

                                            <Grid x:Name="VocaloidAppRow" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="程序路径" />
                                                    <TextBlock Text="用 {file} 传入临时文本文件。"
                                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBox x:Name="VocaloidAppBox" Width="220"
                                                             PlaceholderText="C:\...\XStudio.exe" />
                                                    <Button Content="浏览…" Click="BrowseVocaloidApp_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- MiMo 的这几项只在「自动 / MiMo 语音」时露出来，选别的引擎就整块收起来 -->
                                        <StackPanel x:Name="MimoPanel" Spacing="16">
                                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MiMo API Key" VerticalAlignment="Center" />
                                                <PasswordBox x:Name="MimoKeyBox" Grid.Column="1" PasswordRevealMode="Peek" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MiMo 接口地址" VerticalAlignment="Center" />
                                                <TextBox x:Name="MimoBaseBox" Grid.Column="1" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MiMo 模型" VerticalAlignment="Center" />
                                                <TextBox x:Name="MimoModelBox" Grid.Column="1" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MiMo 音色" VerticalAlignment="Center" />
                                                <TextBox x:Name="MimoVoiceBox" Grid.Column="1" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="320" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MiMo 风格" VerticalAlignment="Center" />
                                                <TextBox x:Name="MimoStyleBox" Grid.Column="1" />
                                            </Grid>
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="320" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Microsoft 语音" VerticalAlignment="Center" />
                                            <ComboBox x:Name="WindowsVoiceCombo" Grid.Column="1"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="选一个本机语音" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="语速" />
                                                <TextBlock Text="-10 到 10，0 是正常语速。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <NumberBox x:Name="WindowsRateBox" Grid.Column="1" Width="180"
                                                       SpinButtonPlacementMode="Compact" Minimum="-10"
                                                       Maximum="10" SmallChange="1" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="自动朗读" />
                                                <TextBlock Text="每条回答出来后直接读一遍。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="AutoReadSwitch" Grid.Column="1"
                                                          OnContent="开启" OffContent="关闭"
                                                          Toggled="AutoReadSwitch_Toggled" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="保存语音设置" Style="{StaticResource AccentButtonStyle}"
                                                    Click="SaveVoice_Click" />
                                            <Button Content="试听" Click="VoicePreview_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="VoiceHintText" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="OrbExpander" Grid.Row="4" Header="AI Agent Orb"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Margin="0,4,0,8" Padding="16,14" CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="230" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="显示 Agent Orb" />
                                                    <TextBlock Text="思考与执行工具时这个球体会加速呼吸；空闲时缓慢起伏。"
                                                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ToggleSwitch x:Name="OrbEnabledSwitch" Grid.Column="1"
                                                              OnContent="显示" OffContent="隐藏"
                                                              Toggled="OrbEnabledSwitch_Toggled" />
                                            </Grid>

                                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                            <StackPanel Spacing="6">
                                                <TextBlock Text="主色 A" />
                                                <TextBox x:Name="OrbPrimaryBox" PlaceholderText="留空则使用默认颜色"
                                                         TextChanged="OrbColorBox_TextChanged" />
                                                <StackPanel x:Name="OrbPrimarySwatches" Orientation="Horizontal" Spacing="6" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <TextBlock Text="主色 B" />
                                                <TextBox x:Name="OrbSecondaryBox" PlaceholderText="留空则使用默认颜色"
                                                         TextChanged="OrbColorBox_TextChanged" />
                                                <StackPanel x:Name="OrbSecondarySwatches" Orientation="Horizontal" Spacing="6" />
                                            </StackPanel>

                                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="OrbSizeLabel" Text="主窗口尺寸 34px" />
                                                <Slider x:Name="OrbSizeSlider" Minimum="16" Maximum="64"
                                                        StepFrequency="1" ValueChanged="OrbSizeSlider_ValueChanged" />
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="OrbBarSizeLabel" Text="指令栏尺寸 96px" />
                                                <Slider x:Name="OrbBarSizeSlider" Minimum="40" Maximum="180"
                                                        StepFrequency="2" ValueChanged="OrbBarSizeSlider_ValueChanged" />
                                            </StackPanel>
                                            <TextBlock Text="改动会立即生效，拖动球体可以把它放到任何位置。"
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Margin="16,0,0,0" CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid x:Name="OrbPreviewHost" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Expander>

                            <Expander x:Name="PermissionExpander" Grid.Row="5" Header="权限"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Margin="0,4,0,8" Padding="16,14" CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="可操作的目录" />
                                            <RadioButtons x:Name="ScopeRadios"
                                                          SelectionChanged="ScopeRadios_SelectionChanged">
                                                <RadioButton Content="仅当前工作区文件夹" />
                                                <RadioButton Content="整个电脑（所有磁盘）" />
                                            </RadioButtons>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="危险操作（删除、覆盖、装东西、跑命令）" />
                                            <ToggleSwitch x:Name="AutoApproveSwitch" OnContent="自动批准"
                                                          OffContent="每次询问"
                                                          Toggled="AutoApproveSwitch_Toggled" />
                                            <TextBlock x:Name="AutoApproveHint" TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="GeneralExpander" Grid.Row="6" Header="通用"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border Margin="0,4,0,8" Padding="16,14" CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="保留的历史轮数" />
                                                <TextBlock Text="每次请求带上的上文轮数。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <NumberBox x:Name="HistoryBox" Grid.Column="1" Width="180"
                                                       SpinButtonPlacementMode="Compact" Minimum="2"
                                                       Maximum="200" SmallChange="2"
                                                       ValueChanged="HistoryBox_ValueChanged" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="桌面通知" />
                                                <TextBlock Text="任务结束时提醒一声。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="NotificationsSwitch" Grid.Column="1"
                                                          OnContent="开启" OffContent="关闭"
                                                          Toggled="NotificationsSwitch_Toggled" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="开机自启" />
                                                <TextBlock Text="登录后自动把本小姐叫起来。"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="RunAtLoginSwitch" Grid.Column="1"
                                                          OnContent="开启" OffContent="关闭"
                                                          Toggled="RunAtLoginSwitch_Toggled" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander x:Name="AboutExpander" Grid.Row="7" Header="关于"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Border x:Name="AboutCard" Margin="0,4,0,8" Padding="16,14" CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Tapped="AboutCard_Tapped" RightTapped="AboutCard_RightTapped">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="AboutLogoImage" Grid.Column="0" Width="52" Height="52"
                                               Margin="0,0,16,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="DomeOS AI Agent Dev"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="DomeOS Team AI Agent"
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="AboutHintText" Text="这里没什么好看的。"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <Button Content="隐私政策" Tag="privacy.md" Click="LegalDoc_Click" />
                                                <Button Content="用户协议" Tag="terms.md" Click="LegalDoc_Click" />
                                                <Button Content="开源声明" Tag="opensource.md" Click="LegalDoc_Click" />
                                                <Button Content="鸣谢" Click="Credits_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Expander>

                            <TextBlock x:Name="SettingsStatus" Grid.Row="8" Margin="4,4,0,0"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </NavigationView>

        <!-- 彩蛋：1+ 的整窗 Never Settle 动画（内容由 NeverSettleScene 现场搭建） -->
        <Grid x:Name="EggLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
              Tapped="EggLayer_Tapped" />

        <!-- 彩蛋：RunDuck 小游戏 -->
        <Grid x:Name="RunDuckLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
              Background="#66000000">
            <Border MaxWidth="660" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="8" Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="RunDuck" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="空格 / ↑ 跳跃 · ↓ 下蹲" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="30" Height="30" Padding="0"
                                Background="Transparent" BorderThickness="0" Click="RunDuckClose_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="13" />
                        </Button>
                    </Grid>
                    <Grid>
                        <Image x:Name="RunDuckImage" Width="600" Height="150" Tapped="RunDuckImage_Tapped" />
                        <TextBlock x:Name="RunDuckScore" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,8,12,0" FontFamily="Consolas" FontSize="11"
                                   Foreground="#FF535353" Text="00000" IsHitTestVisible="False" />
                        <StackPanel x:Name="RunDuckOver" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="4" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock Text="GAME OVER" FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                       Foreground="#FF535353" HorizontalAlignment="Center" />
                            <TextBlock Text="按 空格 / 点击 重新开始" FontFamily="Consolas" FontSize="12"
                                       Foreground="#FF535353" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 新手引导：整窗的向导页，照 Fluent Launcher 的安装向导摆
             顶部步骤条 / 中间左边品牌右边内容 / 底部一左一右的按钮 -->
        <Grid x:Name="OnboardingLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                    <GradientStop Color="#FF45362D" Offset="0" />
                    <GradientStop Color="#FF36383C" Offset="0.38" />
                    <GradientStop Color="#FF2B2D31" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 步骤条：图标 + 名字，当前这一步是蓝色并带一条下划线 -->
            <StackPanel x:Name="OnboardStepBar" Grid.Row="0" Orientation="Horizontal"
                        Margin="28,12,150,0" Spacing="26" />

            <!-- 中间：左边品牌，右边当前步骤；窗口太窄时把品牌收起来，把地方留给内容 -->
            <Grid Grid.Row="1" Margin="40,0,40,16" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="OnboardBrandColumn" Width="320" />
                    <ColumnDefinition x:Name="OnboardGapColumn" Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="WideOnboard">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="820" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="NarrowOnboard">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="OnboardBrand.Visibility" Value="Collapsed" />
                                <Setter Target="OnboardBrandColumn.Width" Value="0" />
                                <Setter Target="OnboardGapColumn.Width" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid x:Name="OnboardBrand" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="OnboardLogoImage" Grid.Column="0" Width="64" Height="64"
                           VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="16,4,0,0" Spacing="2">
                        <TextBlock x:Name="OnboardVersionText" Text="开发版"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="#FFC3C5C9" />
                        <TextBlock Text="DomeOS AI Agent Dev" FontSize="22" FontWeight="SemiBold"
                                   Foreground="White" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Column="2" VerticalAlignment="Center"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="460">
                    <StackPanel MaxWidth="420" HorizontalAlignment="Left" Spacing="10">
                        <StackPanel x:Name="OnboardBody" Spacing="10" />
                        <TextBlock x:Name="OnboardNote" TextWrapping="Wrap"
                                   Foreground="#FFE0A17B" Visibility="Collapsed"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底栏：左边上一步，右边跳过引导 + 下一步 -->
            <Border Grid.Row="2" Background="#FF2C2E32"
                    BorderBrush="#FF232427" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Button x:Name="OnboardBackButton" Content="上一步" Width="88"
                            HorizontalAlignment="Left" Click="OnboardBack_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button x:Name="OnboardSkipButton" Content="跳过引导"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#FFB9BBBE" Click="OnboardSkip_Click" />
                        <Button x:Name="OnboardNextButton" Content="下一步" Width="96"
                                Style="{StaticResource AccentButtonStyle}" Click="OnboardNext_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
